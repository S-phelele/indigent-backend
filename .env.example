# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# --- Database ---------------------------------------------------------------
# Special characters in the password MUST be percent-encoded: @ becomes %40.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/indigent_register?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# The server refuses to start in production if this is missing or a placeholder.
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"

# --- One-time codes ---------------------------------------------------------
OTP_EXPIRY_MINUTES=10
# Wrong guesses before a code is burned.
OTP_ATTEMPT_LIMIT=5

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
UPLOAD_DIR=./uploads

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the app. Leave 0 when running directly;
# set to the real hop count behind nginx/a load balancer so rate limiting sees
# the client address rather than the proxy's.
TRUST_PROXY_HOPS=0

# --- Service levels ---------------------------------------------------------
# Review target in days from submission. Drives the admin SLA Monitor page AND
# the escalation notifications — both read the same value.
SLA_DAYS=14

# Days remaining at which an application is flagged "at risk".
SLA_AT_RISK_DAYS=3

# How often the breach sweep runs. Set to 0 to disable, e.g. when an external
# scheduler drives POST /api/admin/sla/check instead.
SLA_CHECK_INTERVAL_MINUTES=60

# --- Validation -------------------------------------------------------------
# ID numbers: only the 13-digit length and the date of birth are enforced.
# Set to true to also enforce the citizenship digit and the Luhn check digit —
# do this once the existing register has been reconciled, or valid people whose
# records carry a mistyped check digit will be locked out.
SA_ID_STRICT=false

# Meter numbers are length-checked only; SA numbering is not uniform enough to
# enforce a format without rejecting real meters.
METER_MIN_LENGTH=5
METER_MAX_LENGTH=20

# --- Address lookup ---------------------------------------------------------
# Provider: "nominatim" (free, no key) or "google". Defaults to google when
# GOOGLE_MAPS_API_KEY is set, otherwise nominatim.
# GEOCODE_PROVIDER=nominatim

# A monitored municipal mailbox. OpenStreetMap's usage policy asks for a real
# contact so they can reach you rather than simply blocking. Leave unset rather
# than inventing one: an address at example.com is answered with 403.
# GEOCODE_CONTACT=registry@yourmunicipality.gov.za

# Set to use Google instead. Better coverage of informal settlements; needs
# billing enabled on the Google Cloud project.
# GOOGLE_MAPS_API_KEY=

# --- Notifications ----------------------------------------------------------
# Log every notification as it is created. In-app delivery only for now; email
# and SMS hook into deliver() in src/lib/notify.js.
NOTIFY_LOG=false

# Set to true to disable rate limiting (local debugging only).
# DISABLE_RATE_LIMIT=false
