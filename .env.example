# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# --- Database ---------------------------------------------------------------
# Special characters in the password MUST be percent-encoded: @ becomes %40.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/indigent_register?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# The server refuses to start in production if this is missing or a placeholder.
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"

# --- One-time codes ---------------------------------------------------------
OTP_EXPIRY_MINUTES=10
# Wrong guesses before a code is burned.
OTP_ATTEMPT_LIMIT=5

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
UPLOAD_DIR=./uploads

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse proxies in front of the app. Leave 0 when running directly;
# set to the real hop count behind nginx/a load balancer so rate limiting sees
# the client address rather than the proxy's.
TRUST_PROXY_HOPS=0

# --- Service levels ---------------------------------------------------------
# Review target in days from submission. Drives the admin SLA Monitor page AND
# the escalation notifications — both read the same value.
SLA_DAYS=14

# Days remaining at which an application is flagged "at risk".
SLA_AT_RISK_DAYS=3

# How often the breach sweep runs. Set to 0 to disable, e.g. when an external
# scheduler drives POST /api/admin/sla/check instead.
SLA_CHECK_INTERVAL_MINUTES=60

# --- Validation -------------------------------------------------------------
# ID numbers: only the 13-digit length and the date of birth are enforced.
# Set to true to also enforce the citizenship digit and the Luhn check digit —
# do this once the existing register has been reconciled, or valid people whose
# records carry a mistyped check digit will be locked out.
SA_ID_STRICT=false

# Meter numbers are length-checked only; SA numbering is not uniform enough to
# enforce a format without rejecting real meters.
METER_MIN_LENGTH=5
METER_MAX_LENGTH=20

# --- Address lookup ---------------------------------------------------------
# Provider: "nominatim" (free, no key) or "google". Defaults to google when
# GOOGLE_MAPS_API_KEY is set, otherwise nominatim.
# GEOCODE_PROVIDER=nominatim

# A monitored municipal mailbox. OpenStreetMap's usage policy asks for a real
# contact so they can reach you rather than simply blocking. Leave unset rather
# than inventing one: an address at example.com is answered with 403.
# GEOCODE_CONTACT=registry@yourmunicipality.gov.za

# Set to use Google instead. Better coverage of informal settlements; needs
# billing enabled on the Google Cloud project.
# GOOGLE_MAPS_API_KEY=

# --- Notifications ----------------------------------------------------------
# Log every notification as it is created. In-app delivery only for now; email
# and SMS hook into deliver() in src/lib/notify.js.
NOTIFY_LOG=false

# Set to true to disable rate limiting (local debugging only).
# DISABLE_RATE_LIMIT=false

# Link included in SMS messages telling somebody to sign in.
PORTAL_URL=http://localhost:5173

# --- SMS --------------------------------------------------------------------
# "console" prints messages to the server log and stores them in the outbox,
# which is what development uses. "http" posts to a real gateway.
SMS_PROVIDER=console

# Only needed when SMS_PROVIDER=http. Most South African gateways (Clickatell,
# BulkSMS, SMSPortal, Infobip) accept a POST with a bearer token.
# SMS_HTTP_URL=https://api.example-gateway.co.za/v1/messages
# SMS_HTTP_TOKEN=
# SMS_TIMEOUT_MS=10000

# The name or short code the message appears from. Many gateways ignore this
# unless the sender ID has been registered with ICASA.
# SMS_SENDER_ID=INDIGENT

# --- Means test -------------------------------------------------------------
# The household income ceiling, in rand per month. This is a council policy
# decision — set it to the figure in your adopted indigent policy. Common South
# African thresholds sit between R3,500 and R7,200.
INCOME_THRESHOLD=7200

# Per-person ceiling, applied alongside the household one. A household of eight
# on R7,000 is poorer per person than a household of two on the same amount, and
# a household test alone cannot see that. Defaults to the social grant value.
INCOME_PER_PERSON_FLOOR=2090

# Shown to assessment officers as guidance only; does not decide anything.
# INCOME_GUIDANCE_CEILING=

# --- Verification -----------------------------------------------------------
# Site visits before an application can be disqualified for non-contact. Most
# indigent policies use three.
MAX_SITE_VISIT_ATTEMPTS=3

# Prefix on generated application references, e.g. IND-2026-0001.
REFERENCE_PREFIX=IND

# Largest accepted drawn signature, in bytes. A drawn signature is a few
# kilobytes; anything much larger is a pasted photograph.
# SIGNATURE_MAX_BYTES=512000

# --- Annual re-verification -------------------------------------------------
# How long a registration lasts before it must be renewed. Most indigent
# policies require annual re-verification.
RENEWAL_VALID_MONTHS=12

# How far ahead a household is warned that their registration is expiring.
RENEWAL_DUE_SOON_DAYS=60

# Grace period after expiry before the registration lapses.
RENEWAL_GRACE_DAYS=30

# How often the expiry sweep runs. Set to 0 to disable and drive it externally.
RENEWAL_CHECK_INTERVAL_MINUTES=360

# --- Caching ----------------------------------------------------------------
# In-process cache for dashboards and analytics. This is per-instance: running
# several instances behind a load balancer means several caches, which is fine
# for read-mostly aggregates but is the point at which Redis becomes worthwhile.
CACHE_TTL_MS=30000
# DISABLE_CACHE=false
# GEOCODE_CACHE_TTL_MS=86400000
# GEOCODE_TIMEOUT_MS=8000

# --- POPIA: Information Officer ---------------------------------------------
# Section 55 makes the head of a public body the Information Officer, and
# section 56 allows deputies. This is where a data subject sends a request and
# where the Regulator writes, so it is a statutory requirement rather than a
# nicety.
#
# Leave these unset and the privacy notice will say plainly that no Information
# Officer has been recorded, and the admin portal will flag it. That is
# deliberate: a placeholder that looks like a real appointment is worse than a
# visible gap, because nobody chases a gap they cannot see.
MUNICIPALITY_NAME=
INFORMATION_OFFICER_NAME=
INFORMATION_OFFICER_EMAIL=
MUNICIPALITY_POSTAL_ADDRESS=
# DEPUTY_INFORMATION_OFFICER_NAME=
# DEPUTY_INFORMATION_OFFICER_EMAIL=
# MUNICIPAL_HELP_LINE=

# Days the municipality gives itself to answer a subject request. POPIA does not
# fix a single period for every request type; 30 days is the common standard.
SUBJECT_REQUEST_RESPONSE_DAYS=30

# --- POPIA: retention -------------------------------------------------------
# Section 14: personal information may not be kept longer than the purpose it
# was collected for requires. These periods are a council policy decision — set
# them to your municipality's adopted retention schedule.
#
# Declined applications and lapsed registrations are ANONYMISED, not deleted:
# the ward-level demand history survives while the person does not. Approved
# applications are never swept, because they spent public money and must stay
# auditable under the MFMA.
RETENTION_DECLINED_YEARS=5
RETENTION_LAPSED_YEARS=5
RETENTION_DRAFT_YEARS=1
RETENTION_SMS_YEARS=2
# Spent one-time codes. 0.08 years is about 30 days.
RETENTION_OTP_YEARS=0.08

# Whether the scheduled sweep may actually remove records.
#
# Off by default, and it should stay off until somebody has reviewed a survey
# under Privacy in the admin portal and confirmed the periods above match the
# municipality's approved schedule. While it is off the sweep reports what is
# overdue, records that it did so, and changes nothing.
RETENTION_AUTO_APPLY=false

# How often the sweep runs, and how long after boot the first run happens. The
# delay stops a deploy that restarts the process several times from running a
# deletion sweep several times in a minute.
# RETENTION_SWEEP_INTERVAL_MS=86400000
# RETENTION_SWEEP_DELAY_MS=300000
