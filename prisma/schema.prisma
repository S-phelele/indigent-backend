generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  APPLICANT
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  DECLINED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
  PENSIONER
  OTHER
}

enum DocumentType {
  ID_COPY
  BANK_STATEMENTS
  AFFIDAVIT
  PROOF_OF_GRANT
  COPY_OF_DEATH_CERT
  LETTER_OF_AUTHORITY
  OTHER
}

enum DocumentImportance {
  REQUIRED
  OPTIONAL
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          Role     @default(APPLICANT)
  firstName     String?
  lastName      String?
  cellNumber    String?
  idNumber      String?  @unique
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  Application[]
  otps          Otp[]
}

model Otp {
  id        String   @id @default(uuid())
  userId    String?
  cellNumber String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id                    String            @id @default(uuid())
  userId                String
  status                ApplicationStatus @default(DRAFT)
  employmentStatus      EmploymentStatus?
  currentStep           Int               @default(1)

  // Step 1 - Applicant Particulars
  maritalStatus         MaritalStatus?
  surname               String?
  names                 String?
  idNumber              String?
  cellNumber            String?
  residentialAddress    String?
  postalAddress         String?
  employerName          String?
  employerAddress       String?
  workTelNumber         String?
  cellVerified          Boolean           @default(false)

  // Step 2 - Property Particulars
  peopleOnProperty      Int?
  childrenUnder18       Int?
  adults                Int?
  pensionersOver60      Int?
  waterMeterNumber      String?
  electricityMeterNumber String?

  // Step 3 - Household Income
  salary                Decimal?          @db.Decimal(12, 2)
  oldAgePension         Decimal?          @db.Decimal(12, 2)
  disabilityPension     Decimal?          @db.Decimal(12, 2)
  businessIncome        Decimal?          @db.Decimal(12, 2)
  rentingIncome         Decimal?          @db.Decimal(12, 2)
  totalIncomePerPerson  Decimal?          @db.Decimal(12, 2)
  totalHouseholdIncome  Decimal?          @db.Decimal(12, 2)

  // Step 4 - General Information
  ownsImmovableProperty Boolean?
  isFullTimeOccupant    Boolean?
  incomeBelowThreshold  Boolean?          // R4200 or less (or R7500 from landing)
  hasMunicipalArrears   Boolean?
  hasArrearsArrangement Boolean?

  // Meta
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNotes           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents             Document[]

  @@index([status])
  @@index([userId])
  @@index([idNumber])
}

model Document {
  id            String              @id @default(uuid())
  applicationId String
  name          String
  type          DocumentType
  importance    DocumentImportance  @default(REQUIRED)
  fileName      String?
  filePath      String?
  mimeType      String?
  fileSize      Int?
  status        String              @default("Pending") // Pending, Uploaded, Rejected
  uploadedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
